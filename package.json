{
  "name": "craft-collab-embed",
  "version": "2.0.0",
  "description": "Embed the Craft Collab Suite (Craft Docs, Craft Sheets, Craft Slides) in any web page, with a relay for real-time co-editing",
  "type": "module",
  "main": "src/craft-collab-embed.js",
  "module": "src/craft-collab-embed.js",
  "types": "src/craft-collab-embed.d.ts",
  "exports": {
    ".": {
      "types": "./src/craft-collab-embed.d.ts",
      "default": "./src/craft-collab-embed.js"
    },
    "./wordcraft-embed.js": {
      "types": "./src/wordcraft-embed.d.ts",
      "default": "./src/wordcraft-embed.js"
    },
    "./relay/server.mjs": "./relay/server.mjs",
    "./relay/token.mjs": "./relay/token.mjs",
    "./relay/webhook.mjs": "./relay/webhook.mjs",
    "./relay/apps.mjs": "./relay/apps.mjs"
  },
  "files": [
    "src",
    "scripts",
    "relay/*.mjs",
    "relay/*.json",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "fetch-editor": "node scripts/fetch-editor.mjs",
    "start": "node examples/server.mjs",
    "test": "node --test 'relay/test/*.test.mjs' 'test/*.test.mjs'",
    "test:e2e": "node --test test/e2e/collab.e2e.mjs test/e2e/api.e2e.mjs test/e2e/agent.e2e.mjs test/e2e/roles.e2e.mjs test/e2e/suite.e2e.mjs"
  },
  "keywords": [
    "word",
    "docx",
    "spreadsheet",
    "xlsx",
    "presentation",
    "pptx",
    "editor",
    "co-editing",
    "embed",
    "wasm",
    "craft-collab"
  ],
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "craftVersion": "2.0.0"
}
